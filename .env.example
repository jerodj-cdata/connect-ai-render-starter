# Local development only. Copy to .env (gitignored) and fill in.
# On Render, these come from render.yaml and the deploy prompts instead.
# Keep comments on their own lines: an inline comment after an empty value
# is read as the value.

# ============ Required: fill in these three ============
# Your Connect AI login email
CDATA_USERNAME=
# Connect AI > Settings > Access Tokens
# https://docs.cloud.cdata.com/en/Settings/Personal-Access-Tokens
CDATA_PAT=
# https://platform.openai.com/api-keys  (using Anthropic? see below)
OPENAI_API_KEY=

# ============ Everything below is optional ============

# --- Model ---
# Default: openai:gpt-4o. To use Anthropic, uncomment both lines:
# LLM_MODEL=anthropic:claude-sonnet-5
# ANTHROPIC_API_KEY=
# For an OpenAI-compatible gateway (LiteLLM, vLLM, Ollama's /v1), keep the
# openai: prefix, use the gateway's model name, put its key in OPENAI_API_KEY:
# LLM_MODEL=openai:qwen3:14b
# OPENAI_BASE_URL=http://host.docker.internal:4000/v1

# --- Connect AI ---
# Default endpoint sees every connection; a Toolkit's MCP URL scopes the agent
# CDATA_MCP_URL=https://mcp.cloud.cdata.com/mcp

# --- App ---
# Bearer token for /chat and /tools. Leave unset locally: no key is needed and
# the chat page won't ask for one. Render generates one for deployed services.
# APP_API_KEY=
# Delete conversations idle this many days (they include query results); 0 keeps them
# CONVERSATION_RETENTION_DAYS=30
# Follow-up question chips after each answer (one extra LLM call); false turns them off
# SUGGEST_FOLLOWUPS=true

# --- Ports (change if something else already uses them) ---
# AGENT_PORT=8000
# DB_PORT=5432

# --- Database ---
# Only used when running the app outside Docker; docker compose points the
# app at its own db service regardless.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# --- Cron job (optional Salesforce example) ---
# Your Salesforce connection's name in Connect AI (default Salesforce1)
# CDATA_SF_CATALOG=Salesforce1
# DIGEST_LOOKAHEAD_DAYS=14
# SLACK_WEBHOOK_URL=
