# Local development only. Copy to .env (gitignored) and fill in.
# On Render, these come from render.yaml and the deploy prompts instead.
# Keep comments on their own lines: an inline comment after an empty value
# is read as the value.

# --- Connect AI (required) ---
# Your Connect AI login email
CDATA_USERNAME=
# Connect AI > Settings > Access Tokens
CDATA_PAT=

# --- LLM (required: a key for the provider LLM_MODEL names) ---
# "provider:model". Examples: openai:gpt-4o, anthropic:claude-sonnet-5
LLM_MODEL=openai:gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI-compatible gateway (LiteLLM, vLLM, Ollama's /v1): keep the openai:
# prefix, use the gateway's model name, and put the gateway's key above.
# OPENAI_BASE_URL=http://localhost:4000/v1

# --- App ---
# Bearer token for /chat and /tools. Leave empty locally: no key is needed and
# the chat UI won't ask for one. Render generates one for deployed services.
APP_API_KEY=
# Used when running outside Docker. docker compose overrides it to reach its
# own db service, so leave it as is either way.
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# --- Optional ---
# Delete conversations idle this many days (they include query results); 0 keeps them
# CONVERSATION_RETENTION_DAYS=30
# Follow-up question chips after each answer (one extra LLM call); false turns them off
# SUGGEST_FOLLOWUPS=true
# Default endpoint sees every connection; a Toolkit's MCP URL scopes the agent
# CDATA_MCP_URL=https://mcp.cloud.cdata.com/mcp
# Cron job: your Salesforce connection's name in Connect AI (default Salesforce1)
# CDATA_SF_CATALOG=Salesforce1
# DIGEST_LOOKAHEAD_DAYS=14
# SLACK_WEBHOOK_URL=
